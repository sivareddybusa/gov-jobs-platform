# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets (SECURITY.md §19).

# --- Browser-safe (prefixed NEXT_PUBLIC_, inlined into the client bundle) ---
# Safe to expose: meaningless without Row Level Security, which is what
# actually protects the data (SECURITY.md §8).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app, used to build absolute links in auth emails (email
# confirmation, password recovery). Not a secret. Local dev default matches
# supabase/config.toml's [auth] site_url — deliberately "localhost", not
# "127.0.0.1": Next's dev server only trusts the "localhost" origin for
# serving JS chunks, so loading the app via 127.0.0.1 leaves it unhydrated.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix these NEXT_PUBLIC_) ---

# Bypasses Row Level Security entirely. Never exposed to the browser.
# Only used by trusted server-side code (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, for migrations/admin tooling only
# (DATABASE.md §34). Not used by the application at runtime.
DATABASE_URL=

# AI provider key for the job-extraction pipeline (PRD.md §17, SECURITY.md
# §12, lib/ingestion/ai-extract.ts). Google Gemini (TECH_STACK.md's AI
# section) — get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Optional: external exam discovery for admins (Google Programmable Search,
# docs/GOOGLE_SEARCH_INTEGRATION.md). Leave blank to use only the internal
# verified catalog; the admin discovery page then explains it is not configured.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional: bearer secret for the scheduled exam sync endpoint
# (GET /api/cron/exam-sync, header "Authorization: Bearer <value>").
# Leave blank to disable the endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=

# Master key that encrypts LLM API keys saved on /admin/ai-providers
# (AES-256-GCM, 32 random bytes, base64). Server-only. Losing or changing it
# makes saved keys undecryptable (re-add them). Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
